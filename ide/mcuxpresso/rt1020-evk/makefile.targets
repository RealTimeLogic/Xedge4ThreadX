post-build: xedge-output
xedge-output:
	arm-none-eabi-objcopy -O binary xedge.elf xedge.bin
	arm-none-eabi-size xedge.elf

clean: xedge-clean
xedge-clean:
	$(RM) objects.list *.objects libthreadx.a libnetxduo.a libfilex.a liblevelx.a xedge.bin xedge.map
