<?xml version="1.0" encoding="UTF-8"?>
<?fileVersion 4.0.0?>
<cproject storage_type_id="org.eclipse.cdt.core.XmlProjectDescriptionStorage">
  <storageModule moduleId="org.eclipse.cdt.core.settings">
    <cconfiguration id="com.crt.advproject.config.exe.debug.xedge">
      <storageModule buildSystemId="org.eclipse.cdt.managedbuilder.core.configurationDataProvider" id="com.crt.advproject.config.exe.debug.xedge" moduleId="org.eclipse.cdt.core.settings" name="Debug">
        <externalSettings />
        <extensions>
          <extension id="org.eclipse.cdt.core.ELF" point="org.eclipse.cdt.core.BinaryParser" />
          <extension id="org.eclipse.cdt.core.GNU_ELF" point="org.eclipse.cdt.core.BinaryParser" />
        </extensions>
      </storageModule>
      <storageModule moduleId="cdtBuildSystem" version="4.0.0">
        <configuration id="com.crt.advproject.config.exe.debug.xedge" name="Debug" parent="com.crt.advproject.config.exe.debug" artifactName="xedge" artifactExtension="elf" cleanCommand="rm -rf" buildProperties="org.eclipse.cdt.build.core.buildArtefactType=org.eclipse.cdt.build.core.buildArtefactType.exe" buildArtefactType="org.eclipse.cdt.build.core.buildArtefactType.exe" prebuildStep="echo Generated inputs ready" postbuildStep="echo Firmware outputs ready">
          <folderInfo id="com.crt.advproject.config.exe.debug.xedge.root" name="/" resourcePath="">
            <toolChain id="xedge.tc.root" name="NXP MCU Tools" superClass="com.crt.advproject.toolchain.exe.debug" targetTool="xedge.link">
              <targetPlatform id="xedge.platform" superClass="com.crt.advproject.platform.exe.debug" binaryParser="org.eclipse.cdt.core.ELF;org.eclipse.cdt.core.GNU_ELF" />
              <builder id="xedge.builder" superClass="com.crt.advproject.builder.exe.debug" name="Gnu Make Builder" buildPath="${workspace_loc:/Xedge_RT1020}/Debug" managedBuildOn="true" parallelBuildOn="true" parallelizationNumber="8" keepEnvironmentInBuildfile="false" arguments="-r -j8 --output-sync=target" />
              <tool id="xedge.link" name="MCU Linker" superClass="com.crt.advproject.link.exe.debug" command="python" commandLinePattern="${COMMAND} &quot;${ProjDirPath}/../../../tools/ide_link.py&quot; -mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard --specs=nosys.specs -T &quot;./boards/rt1020-evk/generated/rt1020.ld&quot; -Wl,-Map=xedge.map,--gc-sections,--print-memory-usage -o &quot;${OUTPUT}&quot; @objects.list">
                <option id="xedge.link.manage" superClass="com.crt.advproject.link.manage" value="false" valueType="boolean" />
                <outputType id="xedge.link.output" superClass="cdt.managedbuild.tool.gnu.c.linker.output" outputs="elf" />
                <inputType id="xedge.link.input" superClass="cdt.managedbuild.tool.gnu.c.linker.input">
                  <additionalInput kind="additionalinputdependency" paths="$(USER_OBJS)" />
                </inputType>
              </tool>
            </toolChain>
          </folderInfo>
          <folderInfo id="com.crt.advproject.config.exe.debug.xedge.Application" name="Application" resourcePath="Application">
            <toolChain id="xedge.tc.Application" name="NXP MCU Tools" superClass="com.crt.advproject.toolchain.exe.debug">
              <tool id="xedge.Application" name="MCU C Compiler" superClass="com.crt.advproject.gcc.exe.debug" command="arm-none-eabi-gcc" commandLinePattern="${COMMAND} -DCPU_MIMXRT1021DAG5A -DFX_INCLUDE_USER_DEFINE_FILE -DLX_INCLUDE_USER_DEFINE_FILE -DLX_USE_MFLASH -DNX_INCLUDE_USER_DEFINE_FILE -DSDK_DEBUGCONSOLE=1 -DSDK_DEBUGCONSOLE_UART=1 -DSERIAL_PORT_TYPE_UART=1 -DSKIP_SYSCLK_INIT -DTX_INCLUDE_USER_DEFINE_FILE -DXIP_BOOT_HEADER_DCD_ENABLE=1 -DXIP_BOOT_HEADER_ENABLE=1 -DXIP_EXTERNAL_FLASH=1 -D__STARTUP_CLEAR_BSS -D__STARTUP_INITIALIZE_NONCACHEDATA &quot;-I${ProjDirPath}/../../../boards/rt1020-evk/config&quot; &quot;-I${ProjDirPath}/../../../BAS/inc/arch/ThreadX&quot; &quot;-I${ProjDirPath}/../../../BAS/inc&quot; &quot;-I${ProjDirPath}/../../../BAS/examples/xedge/src&quot; &quot;-I${ProjDirPath}/../../../.deps/devices/RT1020/MIMXRT1021&quot; &quot;-I${ProjDirPath}/../../../.deps/devices/RT1020/MIMXRT1021/drivers&quot; &quot;-I${ProjDirPath}/../../../.deps/devices/RT1050/MIMXRT1052/xip&quot; &quot;-I${ProjDirPath}/../../../.deps/cmsis/Core/Include&quot; &quot;-I${ProjDirPath}/../../../.deps/board-examples/_boards/evkmimxrt1020&quot; &quot;-I${ProjDirPath}/../../../.deps/board-examples/_boards/evkmimxrt1020/xip&quot; &quot;-I${ProjDirPath}/../../../.deps/board-examples/_boards/evkmimxrt1020/common/clock&quot; &quot;-I${ProjDirPath}/../../../.deps/board-examples/_boards/evkmimxrt1020/driver_examples/enet/txrx_transfer&quot; &quot;-I${ProjDirPath}/../../../.deps/devices/RT1020/periph&quot; &quot;-I${ProjDirPath}/../../../.deps/examples/evkmimxrt1020/azure_rtos_examples/filex_levelx_mflash&quot; &quot;-I${ProjDirPath}/../../../.deps/sdk/drivers/common&quot; &quot;-I${ProjDirPath}/../../../.deps/sdk/drivers/igpio&quot; &quot;-I${ProjDirPath}/../../../.deps/sdk/drivers/lpuart&quot; &quot;-I${ProjDirPath}/../../../.deps/sdk/drivers/enet&quot; &quot;-I${ProjDirPath}/../../../.deps/sdk/drivers/trng&quot; &quot;-I${ProjDirPath}/../../../.deps/sdk/drivers/flexspi&quot; &quot;-I${ProjDirPath}/../../../.deps/sdk/drivers/cache/armv7-m7&quot; &quot;-I${ProjDirPath}/../../../.deps/components/phy&quot; &quot;-I${ProjDirPath}/../../../.deps/components/phy/device/phyksz8081&quot; &quot;-I${ProjDirPath}/../../../.deps/components/uart&quot; &quot;-I${ProjDirPath}/../../../.deps/components/serial_manager&quot; &quot;-I${ProjDirPath}/../../../.deps/components/lists&quot; &quot;-I${ProjDirPath}/../../../.deps/components/assert&quot; &quot;-I${ProjDirPath}/../../../.deps/components/str&quot; &quot;-I${ProjDirPath}/../../../.deps/components/debug_console_lite&quot; &quot;-I${ProjDirPath}/../../../.deps/components/flash/mflash&quot; &quot;-I${ProjDirPath}/../../../.deps/components/flash/mflash/mimxrt1021&quot; &quot;-I${ProjDirPath}/../../../.deps/nxp-rtos/ports/netxduo&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/ports/cortex_m7/gnu/inc&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/common/inc&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/auto_ip&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/azure_iot&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/BSD&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/cloud&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/dhcp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/dns&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/ftp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/http&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/mdns&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/mqtt&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/nat&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/pop3&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/ppp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/pppoe&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/ptp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/smtp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/snmp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/sntp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/telnet&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/tftp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/web&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/websocket&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/rtp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/addons/rtsp&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/crypto_libraries/inc&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/nx_secure/inc&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/nx_secure/ports&quot; &quot;-I${ProjDirPath}/../../../.deps/netxduo/tsn/inc&quot; -I./boards/rt1020-evk/netxduo/custom_inc &quot;-I${ProjDirPath}/../../../.deps/levelx/common/inc&quot; -I./boards/rt1020-evk/levelx/custom_inc &quot;-I${ProjDirPath}/../../../.deps/filex/ports/cortex_m7/gnu/inc&quot; &quot;-I${ProjDirPath}/../../../.deps/filex/common/inc&quot; -I./boards/rt1020-evk/filex/custom_inc -isystem &quot;${ProjDirPath}/../../../.deps/threadx/ports/cortex_m7/gnu/inc&quot; -isystem &quot;${ProjDirPath}/../../../.deps/threadx/common/inc&quot; -isystem ./boards/rt1020-evk/threadx/custom_inc -mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard -ffunction-sections -fdata-sections -fno-common -UNDEBUG &quot;-ffile-prefix-map=$(realpath ../../../..)=.&quot; &quot;-ffile-prefix-map=$(realpath ../../../../.deps)=deps&quot; &quot;-ffile-prefix-map=$(CURDIR)=build&quot; -Og -g3 -MMD -MP -MF &quot;$(@:%.c.obj=%.d)&quot; -MT &quot;$@&quot; -o ${OUTPUT} -c ${INPUTS}">
